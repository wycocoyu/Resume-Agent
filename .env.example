# ============================================================
# Resume-Agent 后端环境变量
# 复制本文件为 .env，填入你自己的 key 即可本地运行。
# ============================================================

# 必填：DeepSeek 官方 API Key（格式为 sk-...，驱动 AI 对话、简历诊断与 JSON 结构化组装）
# 也可在启动后访问网页端 /settings「AI 与 OCR 服务配置」可视化保存并热更新生效
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 推荐：智谱 BigModel API Key（格式为 id.secret，含英文点号 .，驱动 glm-ocr 版面识别，PDF 与图片导入必需）
# 注意：请勿与上方 sk- 开头的 DeepSeek 密钥混淆，后端已内置跨通道格式校验与多 Worker 自动热加载
# 申请地址：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# 可选：RuoLi 视觉备用通道
RUOLI_API_KEY=

# 可选：OpenAI 兼容模型（留空则不启用）
OPENAI_API_KEY=

# 本地安全密钥（JWT 签名用，本地随便填一串随机字符即可）
JWT_SECRET_KEY=change-me-to-a-random-string

# 可选：邮箱发信凭据加密密钥（仅发邮件功能用到，可留空）
EMAIL_CREDENTIAL_ENC_KEY=

# 可选：腾讯云 COS（用于公司 Logo 与头像存储）
COS_SECRET_KEY=

# 可选：数据库（默认走本地 SQLite，启用下方配置则使用 PostgreSQL）
# USE_POSTGRESQL=false
# POSTGRESQL_URL=postgresql+psycopg2://user:password@localhost:5432/resume_db

# 可选：Agent 实验能力（Asking 选择框，默认关闭）
AGENT_ASKING_MODE_ENABLED=false
